{
  "manifest_version": 3,
  "name": "Microsoft TTS Reader",
  "version": "0.3.0",
  "description": "Cross-browser read-aloud with local browser voices and optional Microsoft Azure neural voices.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Start or stop Microsoft TTS Reader"
  },
  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "microsoft-tts-reader@sguzman",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "js": [
        "src/content/namespace.js",
        "src/content/editable-guard.js",
        "src/content/text-model.js",
        "src/content/highlighter.js",
        "src/content/speech-engine.js",
        "src/content/azure-speech-engine.js",
        "src/content/toolbar.js",
        "src/content/reader.js",
        "src/content/content-script.js"
      ],
      "css": ["src/content/content.css"]
    }
  ]
}
